---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import Arrow from './Arrow.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, description, url, logo, logoInset } = entry.data;

// The tile is white in both themes, so a transparent mark reads like the
// filled app icons beside it (and doesn't vanish into the row's hover color).
const tile = 'size-10 shrink-0 overflow-hidden rounded-[10px]';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group hover:bg-border-soft focus-visible:outline-foreground flex items-center gap-3 rounded-xl p-2 transition-colors focus-visible:outline-2"
>
  {
    !logo ? (
      <div class:list={[tile, 'border-border border border-dashed']} />
    ) : logoInset ? (
      <div class:list={[tile, 'border-border grid place-items-center border bg-white p-2']}>
        <Image src={logo} alt="" width={48} height={48} class="size-full" />
      </div>
    ) : (
      <Image src={logo} alt="" width={80} height={80} class:list={[tile, 'object-cover']} />
    )
  }

  <div class="min-w-0 flex-1">
    <span class="text-[0.92rem] font-semibold"
      >{title}</span
    >
    <p class="text-muted-foreground text-[0.85rem] leading-snug">{description}</p>
  </div>
  <Arrow />
</a>
