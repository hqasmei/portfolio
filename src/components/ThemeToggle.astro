---
// Icons: lucide's `sun` and `moon`, inlined. Only one is visible at a time,
// picked in CSS off the `dark` class so there's nothing to hydrate.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="text-muted-foreground hover:text-foreground hover:bg-border-soft focus-visible:outline-foreground -mr-1.5 grid h-8 w-8 cursor-pointer place-items-center rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <svg
    class="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>

  <svg
    class="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  /* Light theme shows the moon (what you'd switch to); dark shows the sun. */
  .icon-sun {
    display: none;
  }
  :global(.dark) .icon-sun {
    display: block;
  }
  :global(.dark) .icon-moon {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {
        /* private mode — the toggle still works for this page view */
      }
    });
  })();
</script>
