---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, description, url, cover, coverAlt } = entry.data;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group focus-visible:outline-foreground block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4"
>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[576, 1152]}
        sizes="(max-width: 640px) 100vw, 576px"
        class="border-border aspect-[16/10] w-full rounded-lg border object-cover transition-opacity duration-200 group-hover:opacity-90"
      />
    ) : (
      <div class="border-border grid aspect-[16/10] w-full place-items-center rounded-lg border border-dashed">
        <span class="label">Screenshot</span>
      </div>
    )
  }

  <div class="mt-3.5 flex items-center gap-1.5">
    <span
      class="text-[0.95rem] font-semibold underline-offset-4 group-hover:underline"
      >{title}</span
    >
    <!-- lucide `arrow-up-right`, rounded caps. Drifts on hover. -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="text-muted-foreground group-hover:text-foreground shrink-0 transition-all duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>

  <p class="text-muted-foreground mt-1 text-[0.87rem]">{description}</p>
</a>
