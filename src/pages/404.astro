---
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={`Page not found | ${site.name}`}
  description="The requested page could not be found."
>
  <section>
    <h1 class="label border-border block border-b pb-2.5">404</h1>
    <p class="text-muted-foreground pt-3 text-[0.92rem]">
      The requested page could not be found.
    </p>
    <a
      href="/"
      class="focus-visible:outline-foreground mt-3 inline-block rounded-sm text-[0.9rem] font-semibold underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      Back home
    </a>
  </section>
</Layout>
